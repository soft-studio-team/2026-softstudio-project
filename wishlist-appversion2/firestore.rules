rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function emailMatchesAuth(data) {
      return signedIn()
        && data.keys().hasAll(['email'])
        && request.auth.token.email != null
        && data.email.lower() == request.auth.token.email.lower();
    }

    function userEmailMatchesAuth(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && emailMatchesAuth(get(/databases/$(database)/documents/users/$(userId)).data);
    }

    function isFollowerCountStep() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        && (
          request.resource.data.followers == resource.data.get('followers', 0) + 1
          || request.resource.data.followers == resource.data.get('followers', 0) - 1
        );
    }

    function isFollowingCountStep() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following'])
        && (
          request.resource.data.following == resource.data.get('following', 0) + 1
          || request.resource.data.following == resource.data.get('following', 0) - 1
        );
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isFollowerCountStep() || isFollowingCountStep();
      allow delete: if isOwner(userId) || emailMatchesAuth(resource.data);

      function isPublicDoc() {
        return resource.data.get('isPublic', false) == true;
      }

      match /tabs/{tabId} {
        allow read: if isOwner(userId) || (signedIn() && isPublicDoc());
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || userEmailMatchesAuth(userId);
      }

      match /products/{productId} {
        allow read: if isOwner(userId) || (signedIn() && isPublicDoc());
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || userEmailMatchesAuth(userId);
      }

      match /following/{targetId} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || (signedIn() && request.auth.uid == targetId) || userEmailMatchesAuth(userId);
      }

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == followerId;
        allow delete: if (signedIn() && request.auth.uid == followerId) || isOwner(userId) || userEmailMatchesAuth(userId);
      }

      match /notifications/{notifId} {
        allow read, update: if isOwner(userId);
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isOwner(userId) || userEmailMatchesAuth(userId);
      }

      match /receivedBaskets/{basketId} {
        allow read: if isOwner(userId);
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isOwner(userId) || userEmailMatchesAuth(userId);
      }

      match /sentBaskets/{basketId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || userEmailMatchesAuth(userId);
      }

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || userEmailMatchesAuth(userId);
      }
    }

    match /handles/{handleId} {
      function handleOwnerAlive() {
        return exists(/databases/$(database)/documents/users/$(resource.data.uid));
      }

      function handleOwnerEmailMatchesAuth() {
        return handleOwnerAlive()
          && emailMatchesAuth(get(/databases/$(database)/documents/users/$(resource.data.uid)).data);
      }

      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid && (resource.data.uid == request.auth.uid || !handleOwnerAlive() || handleOwnerEmailMatchesAuth());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || !handleOwnerAlive() || handleOwnerEmailMatchesAuth());
    }
  }
}
