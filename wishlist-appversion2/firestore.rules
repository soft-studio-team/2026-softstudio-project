rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      // Profiles are public so friend discovery and id-based
      // account recovery (masked email in the app) can work.
      allow read: if true;
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);

      match /tabs/{tabId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /products/{productId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /following/{targetId} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId);
        // Target may remove themselves when deleting their account.
        allow delete: if isOwner(userId)
          || (signedIn() && request.auth.uid == targetId);
      }

      match /followers/{followerId} {
        allow read: if signedIn();
        // A user may add/remove themselves as a follower of someone else.
        allow write: if signedIn() && request.auth.uid == followerId;
      }
    }

    // Unique wishkit ids (@handle). One doc per id, owned by a single uid.
    match /handles/{handleId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
